{
  "language_info": {
    "name": "Wayuunaiki",
    "autonym": "Wayuunaiki",
    "iso_639_3": "guc",
    "family": "Arawakan (Maipuran)",
    "alphabet_standard": "ALAWAY (Alfabeto Único Wayuu - 1984)",
    "vowels": [
      "a",
      "e",
      "i",
      "o",
      "u",
      "ü"
    ],
    "vowel_note": "'ü' represents the high central unrounded vowel [ɨ], similar to a closed 'i' produced further back.",
    "long_vowels": [
      "aa",
      "ee",
      "ii",
      "oo",
      "uu",
      "üü"
    ],
    "glottal_stop": "' (saltillo, a brief glottal pause)",
    "grammar_basics": {
      "word_order": "Predominantly VSO (Verb-Subject-Object), also SVO in discourse.",
      "gender_system": "Masculine (-shi / -tshi) vs Feminine (-sü / -tsü) / Plural (-shii / -tshii).",
      "pronominal_prefixes": {
        "1s": "ta- (yo / my)",
        "2s": "pü- / pi- (tú / your)",
        "3s_masc": "nü- / ni- (él / his)",
        "3s_fem": "sü- / si- (ella / her)",
        "1p": "wa- (nosotros / our)",
        "2p": "jü- / ji- (ustedes / your)",
        "3p": "na- (ellos, ellas / their)"
      }
    }
  },
